; Engine configuration file.
; Oktoberfest Simulator — 2-4 player chaotic Bavarian beer-tent co-op.
; Godot 4.7.x — GDScript, Forward+ renderer, Jolt physics.

config_version=5

[application]

config/name="Oktoberfest Simulator"
config/description="2-4 arkadaş, kaotik bir Oktoberfest çadırında bira/yemek servis ederken didişiyor."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GDScript", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Net="res://autoload/net.gd"
Game="res://autoload/game.gd"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
