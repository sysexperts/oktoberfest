[gd_resource type="Theme" load_steps=11 format=3]

; Knöpfe des Hauptmenüs: Holz, halbtransparent, mit abgeschrägten Ecken.
; Die Fase entsteht aus corner_radius + corner_detail = 1 — dadurch wird aus der
; Rundung eine gerade Schräge, ganz ohne eigene Grafik oder Skript.
; Gold (1, 0.839, 0.349) ist der Akzent und passt zum Logo-Schriftzug.

[sub_resource type="StyleBoxFlat" id="Normal"]
content_margin_left = 30.0
content_margin_top = 10.0
content_margin_right = 30.0
content_margin_bottom = 10.0
bg_color = Color(0.15, 0.093, 0.055, 0.82)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.5, 0.33, 0.16, 0.95)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18
corner_detail = 1

